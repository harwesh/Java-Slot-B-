
import java.util.*;

public class PharmacyInventory {

    public static void main(String[] args) {

        int[] sizes = {1000, 5000, 10000};

        for (int size : sizes) {

            Map<String, Integer> hashMap = new HashMap<>();
            Map<String, Integer> treeMap = new TreeMap<>();
            Map<String, Integer> linkedMap = new LinkedHashMap<>();

            // Insert medicines
            for (int i = size - 1; i >= 0; i--) {
                String code = String.format("M%05d", i);

                hashMap.put(code, i + 10);
                treeMap.put(code, i + 10);
                linkedMap.put(code, i + 10);
            }

            String searchCode = "M00010";

            // Perform 100,000 lookups
            long start = System.nanoTime();
            for (int i = 0; i < 100000; i++) {
                hashMap.get(searchCode);
            }
            long hashTime = System.nanoTime() - start;

            start = System.nanoTime();
            for (int i = 0; i < 100000; i++) {
                treeMap.get(searchCode);
            }
            long treeTime = System.nanoTime() - start;

            start = System.nanoTime();
            for (int i = 0; i < 100000; i++) {
                linkedMap.get(searchCode);
            }
            long linkedTime = System.nanoTime() - start;

            // Generate reports
            start = System.nanoTime();
            String hashReport = new TreeMap<>(hashMap).toString();
            long hashReportTime = System.nanoTime() - start;

            start = System.nanoTime();
            String treeReport = treeMap.toString();
            long treeReportTime = System.nanoTime() - start;

            start = System.nanoTime();
            String linkedReport = linkedMap.toString();
            long linkedReportTime = System.nanoTime() - start;

            System.out.println("\nMedicine count: " + size);

            System.out.println("HashMap lookup: " + hashTime + " ns");
            System.out.println("TreeMap lookup: " + treeTime + " ns");
            System.out.println("LinkedHashMap lookup: " + linkedTime + " ns");

            System.out.println("HashMap sorted report: " + hashReportTime + " ns");
            System.out.println("TreeMap report: " + treeReportTime + " ns");
            System.out.println("LinkedHashMap report: " + linkedReportTime + " ns");

            System.out.println("Code order: " +
                    new TreeMap<>(hashMap).keySet().stream()
                    .limit(5).toList());

            System.out.println("Insertion order: " +
                    linkedMap.keySet().stream().limit(5).toList());
        }
    }
}
