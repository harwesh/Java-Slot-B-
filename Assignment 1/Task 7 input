
class Vehicle {
    double calculateFee() {
        return 0;
    }
}

class TwoWheeler extends Vehicle {
    @Override
    double calculateFee() {
        return 20;
    }
}

class Car extends Vehicle {
    @Override
    double calculateFee() {
        return 60;
    }
}

public class Main {
    public static void main(String[] args) {
        Vehicle v1 = new TwoWheeler();
        Vehicle v2 = new Car();

        System.out.println("TwoWheeler Fee: Rs " +
            v1.calculateFee());
        System.out.println("Car Fee: Rs " +
            v2.calculateFee());
    }
}
