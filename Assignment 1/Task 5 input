
class ParkingTicket {
    static int counter = 100;

    int ticketNo;
    String vehicleNo;

    ParkingTicket(String vehicleNo) {
        this.vehicleNo = vehicleNo;
        ticketNo = ++counter;
    }

    void display() {
        System.out.println(ticketNo + " " + vehicleNo);
    }
}

public class Main {
    public static void main(String[] args) {
        ParkingTicket t1 =
            new ParkingTicket("TN01AB1111");
        ParkingTicket t2 =
            new ParkingTicket("TN02CD2222");
        ParkingTicket t3 =
            new ParkingTicket("TN03EF3333");

        t1.display();
        t2.display();
        t3.display();
    }
}
