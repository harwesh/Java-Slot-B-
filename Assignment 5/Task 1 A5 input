import java.sql.*;

public class WalletTransfer {
    public static void main(String[] args) throws SQLException {
        Connection con = DriverManager.getConnection(
            "jdbc:mysql://localhost:3306/college",
            "root", "password");

        try {
            con.setAutoCommit(false);

            PreparedStatement p1 = con.prepareStatement(
                "UPDATE wallet SET balance=balance-500 WHERE id=1");

            PreparedStatement p2 = con.prepareStatement(
                "UPDATE wallet SET balance=balance+500 WHERE id=2");

            p1.executeUpdate();
            p2.executeUpdate();

            con.commit();
            System.out.println("Transfer successful");

        } catch (SQLException e) {
            con.rollback();
            System.out.println("Transfer failed. Rollback completed.");
        } finally {
            con.close();
        }
    }
}
