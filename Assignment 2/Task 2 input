
import java.util.*;

public class CollectionBenchmark {

    public static void main(String[] args) {

        int[] sizes = {100, 1000, 10000};

        for (int n : sizes) {

            System.out.println("\nSize: " + n);

            ArrayList<Integer> arrayList = new ArrayList<>();
            LinkedList<Integer> linkedList = new LinkedList<>();
            ArrayDeque<Integer> arrayDeque = new ArrayDeque<>();

            long start, end;

            // ArrayList insertion
            start = System.nanoTime();
            for (int i = 0; i < n; i++)
                arrayList.add(i);
            end = System.nanoTime();
            System.out.println("ArrayList Add: " +
                (end - start) / 1000000.0 + " ms");

            // LinkedList insertion
            start = System.nanoTime();
            for (int i = 0; i < n; i++)
                linkedList.add(i);
            end = System.nanoTime();
            System.out.println("LinkedList Add: " +
                (end - start) / 1000000.0 + " ms");

            // ArrayDeque insertion
            start = System.nanoTime();
            for (int i = 0; i < n; i++)
                arrayDeque.addLast(i);
            end = System.nanoTime();
            System.out.println("ArrayDeque Add: " +
                (end - start) / 1000000.0 + " ms");

            // Front insertion
            start = System.nanoTime();
            for (int i = 0; i < n; i++)
                arrayList.add(0, i);
            end = System.nanoTime();
            System.out.println("ArrayList Front Insert: " +
                (end - start) / 1000000.0 + " ms");

            start = System.nanoTime();
            for (int i = 0; i < n; i++)
                linkedList.addFirst(i);
            end = System.nanoTime();
            System.out.println("LinkedList Front Insert: " +
                (end - start) / 1000000.0 + " ms");

            start = System.nanoTime();
            for (int i = 0; i < n; i++)
                arrayDeque.addFirst(i);
            end = System.nanoTime();
            System.out.println("ArrayDeque Front Insert: " +
                (end - start) / 1000000.0 + " ms");

            // Access kth element
            start = System.nanoTime();
            int a = arrayList.get(n / 2);
            end = System.nanoTime();
            System.out.println("ArrayList Access: " +
                (end - start) / 1000000.0 + " ms");

            start = System.nanoTime();
            int b = linkedList.get(n / 2);
            end = System.nanoTime();
            System.out.println("LinkedList Access: " +
                (end - start) / 1000000.0 + " ms");

            // Iteration
            start = System.nanoTime();
            for (int x : arrayList) { }
            end = System.nanoTime();
            System.out.println("ArrayList Iteration: " +
                (end - start) / 1000000.0 + " ms");

            start = System.nanoTime();
            for (int x : linkedList) { }
            end = System.nanoTime();
            System.out.println("LinkedList Iteration: " +
                (end - start) / 1000000.0 + " ms");

            start = System.nanoTime();
            for (int x : arrayDeque) { }
            end = System.nanoTime();
            System.out.println("ArrayDeque Iteration: " +
                (end - start) / 1000000.0 + " ms");
        }
    }
}
